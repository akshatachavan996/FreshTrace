# FreshTrace Environment Configuration Template
# Copy this file to backend/.env and fill in your actual credentials.
# NEVER commit your actual .env file or API keys to version control.

# Application Settings
APP_NAME=FreshTrace
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (SQLite default for simple local setup)
DATABASE_URL=sqlite:///./freshtrace.db

# Bifrost AI Gateway Configuration
# If running Bifrost locally: http://localhost:8080/v1
# If using a hosted gateway: https://api.bifrost.ai/v1
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=your_bifrost_api_key_here
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Tavily Search API Configuration
# Sign up at https://tavily.com to obtain an API key.
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Pipeline Settings
CACHE_EXPIRATION_HOURS=24
MAX_SEARCH_RESULTS=5
REQUEST_TIMEOUT_SECONDS=30.0
